# ============================================================
# Relationship Agent 环境配置模板（复制为 .env）
# 密钥只走环境变量，绝不提交到仓库
# ============================================================

# ---------- 数据库（必填）----------
DATABASE_URL=postgresql+asyncpg://relationship:relationship@localhost:5432/relationship
TEST_DATABASE_URL=postgresql+asyncpg://relationship:relationship@localhost:5432/relationship_test

# ---------- LLM（必填）----------
# deepseek-flash 支持 text+image，用于截图理解
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 运行预算（对应设计点 A5）----------
MAX_TURNS=8
MAX_TOOL_CALLS=12
MAX_RUN_SECONDS=90
MAX_IMAGES=4
MAX_IMAGE_BYTES=8388608

# ---------- 证据（对应设计点 B4）----------
EVIDENCE_DIR=./data/evidence
EVIDENCE_TTL_HOURS=24

# ---------- 会话压缩（对应设计点 D1）----------
COMPACTION_THRESHOLD_TOKENS=40000
COMPACTION_KEEP_RECENT=12

# ---------- 记忆（对应设计点 C10）----------
MEMORY_DOCUMENT_MAX_CHARS=8000

# ---------- 联网（可选）----------
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---------- Langfuse ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO
USER_ID=local-user
USER_TIMEZONE=Asia/Shanghai
